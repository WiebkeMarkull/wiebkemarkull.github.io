# ───────────────────────────────
# Aktiviert Expires / Browser-Cache
# ───────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On

    # Bilder – 30 Tage
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"

    # Fonts – 6 Monate
    ExpiresByType font/ttf "access plus 6 months"
    ExpiresByType font/otf "access plus 6 months"
    ExpiresByType font/woff "access plus 6 months"
    ExpiresByType font/woff2 "access plus 6 months"

    # CSS & JS – 1 Monat
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
</IfModule>

# ───────────────────────────────
# Sicherheit: Cache für HTML-Seiten kurz halten
# ───────────────────────────────
<FilesMatch "\.(html|htm)$">
    ExpiresDefault "access plus 0 seconds"
</FilesMatch>

# ───────────────────────────────
# Optional: Gzip-Kompression aktivieren
# ───────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/x-javascript text/xml application/xml application/xml+rss text/javascript
</IfModule>
